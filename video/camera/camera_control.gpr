with "alr_environment.gpr";
with "camera_lib.gpr";
with "gnoga.gpr";
with "video_lib.gpr";

project Camera_Control is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & ALR_Environment.Build_Mode;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("camera_control.adb");

   package Compiler is
      for Default_Switches ("Ada") use
         Alr_Environment.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use
         Alr_Environment.Ada_Binder_Switches;
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ALR_Environment.Linker_Options;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Builder is
      case ALR_Environment.Build_Mode is

         when "aunit" | "execute" =>
            for Executable ("camera_control.adb") use "camera_control";

         when "help_test" =>
            for Executable ("camera_control.adb") use "help_test";

      end case;
   end Builder;
end Camera_Control;
